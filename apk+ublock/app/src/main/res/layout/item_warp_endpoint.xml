<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemEndpointRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_mode_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/viewEndpointDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_status_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEndpointAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="162.159.195.1:4500" />

        <TextView
            android:id="@+id/tvEndpointNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            tools:text="موصى به لتجاوز الحجب" />

        <TextView
            android:id="@+id/tvEndpointStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="يعمل • 68 ملي ثانية" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMeasureSpeed"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:backgroundTint="@color/surface_soft"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="88dp"
        android:minHeight="36dp"
        android:paddingStart="10dp"
        android:paddingTop="0dp"
        android:paddingEnd="10dp"
        android:paddingBottom="0dp"
        android:text="@string/btn_measure_speed"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

</LinearLayout>
