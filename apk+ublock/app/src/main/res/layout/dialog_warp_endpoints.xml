<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvWarpDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_warp_endpoints_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWarpDialogModeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/warp_dialog_status_auto"
        android:textColor="@color/accent_emerald"
        android:textSize="12sp" />

    <!-- Selection Mode Tabs: Auto vs Manual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_mode_pill"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/btnWarpModeAuto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/warp_mode_tab_auto"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWarpModeManual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/warp_mode_tab_manual"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scan Button & Progress -->
    <Button
        android:id="@+id/btnScanEndpoints"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/cloudflare_orange"
        android:text="@string/btn_scan_warp_endpoints"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pbScanEndpoints"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvScanSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:text="@string/warp_scan_hint"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Scrollable Endpoints List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWarpEndpoints"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_warp_endpoint" />

    <Button
        android:id="@+id/btnCloseWarpDialog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/accent_emerald"
        android:text="@string/btn_close"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
