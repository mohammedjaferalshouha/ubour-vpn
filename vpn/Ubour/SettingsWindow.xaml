<Window x:Class="Ubour.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعدادات - Settings"
        Width="580"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SettingsTitle" Text="إعدادات عبور المتقدمة" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Section 1: Online Filter Rules Updater -->
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="LblFiltersSection" Text="قواعد وتصفية الإعلانات" FontWeight="SemiBold" FontSize="14" />
            <TextBlock x:Name="LblFiltersDesc" Text="تحديث وتوسيع قواعد التصفية عبر الإنترنت لأكثر من مليوني قاعدة (AdGuard, OISD, HaGeZi, StevenBlack)." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" />
            <ProgressBar x:Name="FilterUpdateProgress" Height="8" Margin="0,0,0,10" Visibility="Collapsed" />
            <TextBlock x:Name="TxtUpdateStatus" Text="" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" Visibility="Collapsed" />
            <Button x:Name="BtnUpdateFilters" Content="⟳ تحديث القواعد من الإنترنت الآن" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Click="BtnUpdateFilters_Click" />
          </StackPanel>
        </Border>

        <!-- Section 2: Custom VLESS Reality -->
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="LblVlessSection" Text="خادم VLESS مخصص" FontWeight="SemiBold" FontSize="14" />
            <TextBlock x:Name="LblVlessDesc" Text="أدخل رابط خادم VLESS Reality الخاص بك (يبدأ بـ vless://):" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,8" />
            <TextBox x:Name="TxtVlessUrl" Height="38" Background="{DynamicResource PanelSoftBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="10,8" VerticalContentAlignment="Center" Margin="0,0,0,8" />
          </StackPanel>
        </Border>

        <!-- Section 3: Upstream DoH -->
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="16">
          <StackPanel>
            <TextBlock x:Name="LblDohSection" Text="خادم DNS الآمن (DoH)" FontWeight="SemiBold" FontSize="14" />
            <TextBlock x:Name="LblDohDesc" Text="اختر مزود DoH للاستعلامات النظيفة غير المحجوبة:" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,8" />
            <ComboBox x:Name="CmbDohProvider" Height="36" Background="{DynamicResource PanelSoftBrush}" Foreground="{DynamicResource TextBrush}" Padding="8,4" SelectedIndex="0">
              <ComboBoxItem Content="Cloudflare (https://cloudflare-dns.com/dns-query)" />
              <ComboBoxItem Content="Quad9 (https://dns.quad9.net/dns-query)" />
              <ComboBoxItem Content="Google (https://dns.google/dns-query)" />
              <ComboBoxItem Content="AdGuard DNS (https://dns.adguard-dns.com/dns-query)" />
            </ComboBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="BtnSave" Content="حفظ وإغلاق" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Width="120" Click="BtnSave_Click" />
    </StackPanel>
  </Grid>
</Window>
