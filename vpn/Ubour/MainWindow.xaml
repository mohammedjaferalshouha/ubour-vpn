<Window x:Class="Ubour.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubour - عبور"
        Width="920"
        Height="680"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="cardBorder" Background="{DynamicResource PanelSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="outerCircle" Width="18" Height="18" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Ellipse x:Name="innerCircle" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource PanelSelectedBrush}" />
                <Setter TargetName="outerCircle" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="innerCircle" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="cardBorder" Property="Opacity" Value="0.9" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="AppTitle" Text="عبور + مانع الإعلانات" FontSize="26" FontWeight="Bold" />
        <TextBlock x:Name="AppSubtitle" Text="تجاوز حجب DPI وتصفية شاملة للإعلانات والتتبع" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="SettingsButton" Content="⚙ الإعدادات" Click="SettingsButton_Click" />
        <Button x:Name="LanguageButton" Content="English" Click="LanguageButton_Click" />
        <Button x:Name="ThemeButton" Content="🌙 داكن" Click="ThemeButton_Click" />
      </StackPanel>
    </Grid>

    <!-- Main Content -->
    <Grid Grid.Row="1" Margin="0,18,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="0.9*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Power Button & Modes -->
      <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="22" Margin="0,0,14,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Power Button -->
            <Grid HorizontalAlignment="Center" Margin="0,4,0,14">
              <Ellipse x:Name="PowerGlowRing" Width="140" Height="140" Stroke="{DynamicResource DangerBrush}" StrokeThickness="6" Opacity="0.3" />
              <Button x:Name="PowerButton" Width="120" Height="120" Click="PowerButton_Click" Background="{DynamicResource DangerBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="60">
                      <TextBlock Text="⏻" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.9" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>

            <!-- Status Info -->
            <TextBlock x:Name="StatusLabel" Text="متوقف" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusDetail" Text="اضغط زر التشغيل لبدء الاتصال وتفعيل التصفية" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,16" TextWrapping="Wrap" TextAlignment="Center" />

            <!-- Mode Selection Section -->
            <TextBlock x:Name="ModeSectionTitle" Text="وضع التشغيل الأساسي" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
            
            <RadioButton x:Name="ModeWarp" IsChecked="True" Checked="ModeRadio_Checked">
              <StackPanel>
                <TextBlock x:Name="LblModeWarp" Text="نفق كلاود فلير (Cloudflare WARP) + منع الإعلانات" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="LblModeWarpDesc" Text="حماية وتشفير عالمي مع تصفية كاملة للإعلانات" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeDpiAdBlock" Checked="ModeRadio_Checked">
              <StackPanel>
                <TextBlock x:Name="LblModeDpiAdBlock" Text="تجاوز الحجب المباشر (DPI) + منع الإعلانات" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="LblModeDpiAdBlockDesc" Text="سرعة 100% بدون تغيير الـ IP مع حظر تام للإعلانات" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeAdBlockOnly" Checked="ModeRadio_Checked">
              <StackPanel>
                <TextBlock x:Name="LblModeAdBlockOnly" Text="منع الإعلانات والتتبع فقط" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="LblModeAdBlockOnlyDesc" Text="خفيف جداً على موارد الحاسوب وسرعة فائقة" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeDpiOnly" Checked="ModeRadio_Checked">
              <StackPanel>
                <TextBlock x:Name="LblModeDpiOnly" Text="تجاوز الحجب فقط (بدون تصفية)" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="LblModeDpiOnlyDesc" Text="فك حجب المواقع مباشرة" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeCustomVless" Checked="ModeRadio_Checked">
              <StackPanel>
                <TextBlock x:Name="LblModeCustomVless" Text="خادم VLESS Reality مخصص" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="LblModeCustomVlessDesc" Text="اتصال مشفر متقدم بخادمك الخاص مع منع الإعلانات" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right Column: Live Metrics & Engine Status -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="20">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="MetricsTitle" Text="لوحة الإحصائيات الحية" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

              <!-- Card: Blocked Ads -->
              <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="LblAdsBlocked" Text="إعلانات محجوبة" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtAdsBlocked" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="🛡" FontSize="24" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Card: Blocked Trackers -->
              <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="LblTrackersBlocked" Text="متعقبات محجوبة" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtTrackersBlocked" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="👁" FontSize="24" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Card: Active Rules -->
              <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="LblActiveRules" Text="قواعد التصفية النشطة" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtActiveRules" Text="809,716" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="⚡" FontSize="24" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Card: Total Queries -->
              <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="LblTotalQueries" Text="إجمالي استعلامات DNS" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtTotalQueries" Text="0" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="🌐" FontSize="24" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Card: Uptime -->
              <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="12" Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="LblUptime" Text="مدة الاتصال النشط" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtUptime" Text="00:00:00" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="⏱" FontSize="24" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Engine Status Box -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="14,10" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock x:Name="TxtEngineStatus" Text="حالة المحرك: جاهز للاتصال" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="14,8">
      <Grid>
        <TextBlock x:Name="FooterText" Text="عبور v1.5.1 · تصفية شاملة وتجاوز حجب آمن · مفتوح المصدر" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
