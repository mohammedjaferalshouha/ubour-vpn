<Window x:Class="Ubour.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubour"
        Width="790"
        Height="555"
        MinWidth="690"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="AppTitle" Text="عبور" FontSize="35" FontWeight="SemiBold" />
        <TextBlock x:Name="AppSubtitle" Text="وصول بسيط وآمن إلى المواقع المتاحة" Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="LanguageButton" Content="English" Click="LanguageButton_Click" />
        <Button x:Name="ThemeButton" Content="وضع فاتح" Click="ThemeButton_Click" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,30,0,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*" />
        <ColumnDefinition Width="0.75*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="30" Margin="0,0,18,0">
        <StackPanel>
          <Border x:Name="StatusDot" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource DangerBrush}" HorizontalAlignment="Right" />
          <TextBlock x:Name="StatusLabel" Text="غير متصل" FontSize="25" FontWeight="SemiBold" Margin="0,18,0,4" />
          <TextBlock x:Name="StatusDetail" Text="محرك الاتصال متوقف." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Height="46" />
          <Button x:Name="ToggleButton" Content="تشغيل الاتصال" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,28,0,0" Padding="18,13" Click="ToggleButton_Click" />
          <Button x:Name="CheckUpdatesButton" Content="فحص التحديثات" Margin="0,12,0,0" Click="CheckUpdatesButton_Click" />
          <Button x:Name="OpenEngineReleaseButton" Content="فتح صفحة التحديث الرسمي" Margin="0,6,0,0" Visibility="Collapsed" Click="OpenEngineReleaseButton_Click" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="22" Padding="25">
        <StackPanel>
          <TextBlock x:Name="InfoTitle" Text="حالة البرنامج" FontSize="18" FontWeight="SemiBold" />
          <Separator Margin="0,14" Opacity="0.15" />
          <TextBlock x:Name="EngineInfo" Text="محرك التشغيل: غير مفحوص" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
          <TextBlock x:Name="UpdateInfo" Text="فحص التحديثات عند الفتح." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
          <TextBlock x:Name="ExitInfo" Text="التصغير يبقي الاتصال يعمل. زر الإغلاق يوقفه كليًا." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="13" Padding="15,11">
      <TextBlock x:Name="FooterText" Text="الإصدار 1.0.0 · لا يغيّر عنوان الإنترنت · يتطلب صلاحية مسؤول" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
    </Border>
  </Grid>
</Window>
