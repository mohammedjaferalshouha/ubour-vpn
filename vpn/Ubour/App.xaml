<Application x:Class="Ubour.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="PanelBrush" Color="#121C2E" />
    <SolidColorBrush x:Key="PanelSoftBrush" Color="#1A2740" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F7FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AAB8D0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#32C6B8" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#06201D" />
    <SolidColorBrush x:Key="PanelSelectedBrush" Color="#1E4069" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F39C12" />
  </Application.Resources>
</Application>
