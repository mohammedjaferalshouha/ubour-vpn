<Window x:Class="Ubour.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubour" Height="720" Width="460"
        Icon="pack://application:,,,/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource BgGradientStart}" Offset="0.0"/>
                <GradientStop Color="{DynamicResource BgGradientEnd}" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="5" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid x:Name="RootGrid" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Top Bar -->
            <Grid Grid.Row="0" Margin="20,18,20,10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#10B981" Margin="0,0,10,0">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z M12,11.99h7c-0.53,4.12-3.28,7.79-7,8.94V12H5V6.3l7-3.11V11.99z"
                              Fill="White" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtAppTitle" Text="عبور | Ubour" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Lang Button -->
                    <Border x:Name="BtnLang" MouseLeftButtonDown="BtnLang_Click" Width="32" Height="32" Margin="2" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Cursor="Hand">
                        <TextBlock x:Name="TxtLangShort" Text="EN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Theme Button -->
                    <Border x:Name="BtnTheme" MouseLeftButtonDown="BtnTheme_Click" Width="32" Height="32" Margin="2" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Cursor="Hand">
                        <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                                        <!-- Logs Button -->
                    <Border x:Name="BtnLogs" MouseLeftButtonDown="BtnLogs_Click" Width="32" Height="32" Margin="2" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Cursor="Hand" ToolTip="سجل العمليات والأخطاء">
                        <TextBlock Text="📋" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Settings Button -->
                    <Border x:Name="BtnSettings" MouseLeftButtonDown="BtnSettings_Click" Width="32" Height="32" Margin="2" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Cursor="Hand">
                        <TextBlock Text="⚙" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Minimize Button -->
                    <Border x:Name="BtnMinimize" MouseLeftButtonDown="BtnMinimize_Click" Width="32" Height="32" Margin="2" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Cursor="Hand">
                        <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Close (Hide to Tray) Button -->
                    <Border x:Name="BtnClose" PreviewMouseLeftButtonDown="BtnClose_Click" Width="32" Height="32" Margin="2" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2. Status & Power Section -->
            <StackPanel Grid.Row="1" Margin="20,10,20,15" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtStatusTitle" Text="جاهز للاتصال" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtStatusDesc" Text="اختر الوضع المناسب ثم اضغط زر الاتصال" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>

                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <Ellipse x:Name="PowerGlowRing" Width="118" Height="118" Stroke="#EF4444" StrokeThickness="2" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <BlurEffect Radius="8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Border x:Name="BtnPower" MouseLeftButtonDown="BtnPower_Click" Width="100" Height="100" CornerRadius="50" Background="{DynamicResource PowerBtnOffBrush}" BorderThickness="2" BorderBrush="#33FFFFFF" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="PowerIcon" Data="M16.56,4.44C19.84,5.92,22,9.36,22,13c0,4.97-4.03,9-9,9s-9-4.03-9-9c0-3.64,2.16-7.08,5.44-8.56 L10,6.23C7.54,7.46,6,10.08,6,13c0,3.87,3.13,7,7,7s7-3.13,7-7c0-2.92-1.54-5.54-4-6.77V4.44z M13,2h-2v10h2V2z"
                              Fill="#EF4444" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 3. Operation Modes Section -->
            <StackPanel Grid.Row="2" Margin="20,0,20,10">
                <!-- Mode 1: WARP + AdBlock -->
                <Border x:Name="CardModeWarp" MouseLeftButtonDown="CardMode_Click" Tag="0" CornerRadius="12" Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="14,10" Margin="0,0,0,8" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1AF97316" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModeWarpTitle" Text="كلاود فلير + مانع الإعلانات" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtModeWarpDesc" Text="نفق مشفر كامل مع حظر الإعلانات والتعقبات" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <RadioButton x:Name="RbModeWarp" Grid.Column="2" IsChecked="False" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- WARP Sub-Mode Inline Selector -->
                <Border x:Name="WarpSubModeContainer" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="10,6" Margin="0,-4,0,8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblWarpSubMode" Text="خيارات النفق:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="RbWarpWithAds" Content="مع مانع الإعلانات" GroupName="WarpSubModeGroup" IsChecked="True" FontSize="10.5" Margin="0,0,8,0" Checked="WarpMode_Checked" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"/>
                            <RadioButton x:Name="RbWarpOnly" Content="النفق فقط (أقصى سرعة)" GroupName="WarpSubModeGroup" IsChecked="False" FontSize="10.5" Checked="WarpMode_Checked" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mode 2: AdBlock Only -->
                <Border x:Name="CardModeAdBlock" MouseLeftButtonDown="CardMode_Click" Tag="1" CornerRadius="12" Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="14,10" Margin="0,0,0,8" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A3B82F6" Margin="0,0,12,0">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModeAdBlockTitle" Text="مانع الإعلانات فقط" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtModeAdBlockDesc" Text="اتصال مباشر وسريع 100% مع تصفية الإعلانات" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <RadioButton x:Name="RbModeAdBlock" Grid.Column="2" IsChecked="False" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Mode 3: Bypass Only (GoodbyeDPI) -->
                <Border x:Name="CardModeVpnOnly" MouseLeftButtonDown="CardMode_Click" Tag="2" CornerRadius="12" Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="#10B981" Padding="14,10" Margin="0,0,0,8" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A06B6D4" Margin="0,0,12,0">
                            <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModeVpnOnlyTitle" Text="تجاوز الحجب فقط" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtModeVpnOnlyDesc" Text="محرك GoodbyeDPI الأصلي بالوضع القياسي -9" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <RadioButton x:Name="RbModeVpnOnly" Grid.Column="2" IsChecked="True" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Mode 4: Bypass + AdBlock -->
                <Border x:Name="CardModeVpnAdBlock" MouseLeftButtonDown="CardMode_Click" Tag="3" CornerRadius="12" Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="14,10" Margin="0,0,0,4" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A10B981" Margin="0,0,12,0">
                            <TextBlock Text="✨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModeVpnAdBlockTitle" Text="تجاوز الحجب + مانع الإعلانات" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtModeVpnAdBlockDesc" Text="فك الحجب السريع مع تصفية الإعلانات محلياً" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <RadioButton x:Name="RbModeVpnAdBlock" Grid.Column="2" IsChecked="False" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- DPI Strength Inline Selector -->
                <Border x:Name="DpiSubModeContainer" Visibility="Visible" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="10,6" Margin="0,2,0,4" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblDpiStrength" Text="نمط فك الحجب:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="RbDpiStable" Content="المستقر (-1)" GroupName="DpiStrengthGroup" IsChecked="True" FontSize="10.5" Margin="0,0,8,0" Checked="DpiMode_Checked" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"/>
                            <RadioButton x:Name="RbDpiMedium" Content="المتوسط (-5)" GroupName="DpiStrengthGroup" IsChecked="False" FontSize="10.5" Margin="0,0,8,0" Checked="DpiMode_Checked" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"/>
                            <RadioButton x:Name="RbDpiAggressive" Content="الأقصى (-9)" GroupName="DpiStrengthGroup" IsChecked="False" FontSize="10.5" Checked="DpiMode_Checked" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 4. Live Stats Dashboard -->
            <Border Grid.Row="3" Margin="20,0,20,18" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="LblStatDuration" Text="مدة الاتصال" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatDuration" Text="00:00:00" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Fill="{DynamicResource CardBorderBrush}" Height="24" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="LblStatAds" Text="إعلانات محجوبة" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatAds" Text="0" FontSize="14" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Fill="{DynamicResource CardBorderBrush}" Height="24" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="LblStatTrackers" Text="تعقبات محجوبة" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatTrackers" Text="0" FontSize="14" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

                        <!-- Diagnostic Logs Modal Overlay -->
            <Grid x:Name="LogsOverlay" Grid.RowSpan="4" Background="#E6000000" Visibility="Collapsed">
                <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Margin="15" Padding="15" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="سجل العمليات والتشخيص الفوري" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border MouseLeftButtonDown="BtnCloseLogs_Click" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Logs Text Box -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" BorderThickness="1" BorderBrush="#334155" Margin="0,0,0,10" Padding="8">
                            <ScrollViewer x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtLogs" FontFamily="Consolas, Courier New" FontSize="11" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Actions -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnCopyLogs" Click="BtnCopyLogs_Click" Grid.Column="0" Content="نسخ السجل 📋" Height="34" Margin="2" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnSaveLogs" Click="BtnSaveLogs_Click" Grid.Column="1" Content="حفظ كملف 💾" Height="34" Margin="2" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnClearLogs" Click="BtnClearLogs_Click" Grid.Column="2" Content="مسح 🗑" Height="34" Margin="2" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Settings Modal Overlay -->
            <Grid x:Name="SettingsOverlay" Grid.RowSpan="4" Background="#E6000000" Visibility="Collapsed">
                <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Margin="25" Padding="20" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TxtSettingsHeader" Text="الإعدادات العامة" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                        <TextBlock x:Name="LblSettingsLang" Text="اللغة:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbLanguage" SelectionChanged="CmbLanguage_SelectionChanged" Margin="0,0,0,12" Padding="8,6">
                            <ComboBoxItem Content="العربية (Arabic)" Tag="ar" IsSelected="True"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>

                        <TextBlock x:Name="LblSettingsTheme" Text="المظهر:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTheme" SelectionChanged="CmbTheme_SelectionChanged" Margin="0,0,0,12" Padding="8,6">
                            <ComboBoxItem Content="المظهر المظلم (Dark)" Tag="dark" IsSelected="True"/>
                            <ComboBoxItem Content="المظهر الفاتح (Light)"/>
                        </ComboBox>

                        <TextBlock x:Name="LblSettingsDns" Text="مزود الأسماء (DNS):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbDns" Margin="0,0,0,12" Padding="8,6">
                            <ComboBoxItem Content="Cloudflare (1.1.1.1)" Tag="1.1.1.1" IsSelected="True"/>
                            <ComboBoxItem Content="Google DNS (8.8.8.8)" Tag="8.8.8.8"/>
                            <ComboBoxItem Content="AdGuard DNS (94.140.14.14)" Tag="94.140.14.14"/>
                            <ComboBoxItem Content="Quad9 (9.9.9.9)" Tag="9.9.9.9"/>
                        </ComboBox>

                        <TextBlock x:Name="LblSettingsVless" Text="رابط خادم VLESS مخصص:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtVlessUrl" Height="32" Padding="6" Margin="0,0,0,12" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <!-- Updates Section -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtAppVersion" Text="الإصدار: v1.6.1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" Content="فحص التحديثات 🔄" Height="28" Padding="10,2" HorizontalAlignment="Left" Background="#3B82F6" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="TxtUpdateStatus" Text="" FontSize="11" Foreground="#10B981" Visibility="Collapsed" Margin="0,2,0,4"/>
                                <Button x:Name="BtnDownloadUpdate" Click="BtnDownloadUpdate_Click" Content="تحميل التحديث ⬇" Height="28" Background="#10B981" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Margin="0,4,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnCloseSettings" Click="BtnCloseSettings_Click" Content="إغلاق وحفظ" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>